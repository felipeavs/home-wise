# Copie este arquivo para .env e preencha. O .env NUNCA vai para o Git.
# Este arquivo (.env.example) só contém nomes de variáveis, sem valores reais.

# Chave da API da Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Modelo usado na extração e nos agentes
HOMEWISE_MODEL=claude-sonnet-5-5

# Banco de dados (Fase 1: SQLite local; Fase 2: PostgreSQL)
HOMEWISE_DATABASE_URL=sqlite:///data/homewise.db

# Telegram (Fase 4)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
